{
  "name": "multi-encrypt",
  "version": "2.0.0",
  "description": "A simple no-install solution to encrypt/decrypt multiple files in a public repo",
  "main": "./src/index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "encrypt",
    "secret",
    "password",
    "sensitive",
    "decrypt",
    "vault",
    "blackbox",
    "cipher"
  ],
  "bin": {
    "multi-encrypt": "./bin/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/onexdata/multi-encrypt"
  },
  "author": {
    "name": "Nick Steele",
    "email": "njsteele@gmail.com"
  },
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^8.3.0",
    "inquirer": "^8.2.0"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/__tests__/**/*.test.js"],
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageReporters": ["text", "lcov"],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}